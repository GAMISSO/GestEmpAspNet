@{
    ViewData["Title"] = "Departement Page";
}
@model IEnumerable<Models.Departement>

<div class="max-w-7xl mx-auto bg-white p-6 rounded-xl shadow">

        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold">Liste des Départements</h1>
        </div>

        <!-- Filtres -->
        <div class="flex flex-wrap gap-4 mb-6">

            <input type="text" placeholder="Rechercher un compte..."
                class="border rounded-md px-4 py-2 w-64 shadow-sm">
                <button class="bg-blue-600 text-white px-5 py-2 rounded-md hover:bg-blue-700 shadow" type="submit">
                <i class="fas fa-search mr-2"></i> Creer
            </button>


        </div>

        <!-- Tableau -->
        <table class="w-full border-collapse">
            <thead>
                <tr class="border-b bg-gray-50 text-left text-gray-600">
                    <th >ID</th>
                    <th >Nom</th>
                    <th >Date de création</th>
                    <th >Statut</th>
                    <th >Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var departement in Model)
                {
                    <tr class="border-b">
                        <td >@departement.Id</td>
                        <td >@departement.Name</td>
                        <td >@departement.DateCreation.ToString("dd/MM/yyyy")</td>
                        @if (departement.IsActive)
                        {
                            <td > <span class="badge bg-success">Actif</span> </td>
                        }
                        else
                        {
                            <td > <span class="badge bg-danger">Inactif</span> </td>
                        }
                        <td>
                            <div class="flex gap-2">
                                <a asp-controller="Employe" asp-action="Index" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i>Employe
                            </a>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

        <!-- Pagination -->
        <div class="flex items-center gap-3 mt-4 text-sm">
            <span class="text-gray-600">Précédent</span>
            <span class="px-3 py-1 bg-blue-600 text-white rounded-md">1</span>
            <span class="px-3 py-1 bg-gray-200 text-gray-800 rounded-md">2</span>
            <span class="px-3 py-1 bg-gray-200 text-gray-800 rounded-md">3</span>
            <span class="text-blue-600 cursor-pointer">Suivant</span>
        </div>

    </div>